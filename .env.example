# Copy to .env.local when running on your own computer (see docs/moving-off-render.md). Never commit real keys.
KIT_MODE=1
TZ=America/New_York
JARVIS_PASSWORD=choose-a-password
SESSION_SECRET=any-long-random-text
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional
HOME_CITY=
HOME_REGION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
SALESHANDY_API_KEY=
TELEGRAM_BOT_TOKEN=
# Optional: AI_PROVIDER=openrouter (with OPENROUTER_API_KEY) or ollama, plus AI_MODEL
AI_PROVIDER=
AI_MODEL=
